ELASTICSEARCH_TIMEOUT=30
ELASTICSEARCH_MAX_RETRIES=3

# MCP-сервер
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Эмбеддинги (внешний сервис; пусто = только лексический поиск)
